<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="1024.0"
            prefHeight="768.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <!-- TOP -->
    <top>
        <VBox>
            <children>

                <MenuBar>
                    <menus>
                        <Menu text="Options">
                            <items>
                                <Menu text="Update Store">
                                    <items>
                                        <MenuItem text="Add Book"/>
                                        <MenuItem text="Add CD"/>
                                        <MenuItem text="Add DVD"/>
                                    </items>
                                </Menu>

                                <MenuItem text="View Store"/>
                                <MenuItem text="View Cart"/>
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>

                <Label text="CART"
                       style="-fx-font-size: 50px; -fx-text-fill: aqua;">
                    <padding>
                        <Insets left="10"/>
                    </padding>
                </Label>

            </children>
        </VBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets left="10"/>
            </padding>

            <children>

                <HBox alignment="CENTER_LEFT"
                      spacing="10">
                    <padding>
                        <Insets top="10" bottom="10"/>
                    </padding>

                    <children>

                        <Label text="Filter:"/>

                        <TextField fx:id="tfFilter"/>

                        <RadioButton fx:id="radioBtnFilterId"
                                     text="By ID"
                                     selected="true">
                            <toggleGroup>
                                <ToggleGroup fx:id="filterCategory"/>
                            </toggleGroup>
                        </RadioButton>

                        <RadioButton fx:id="radioBtnFilterTitle"
                                     text="By Title"
                                     toggleGroup="$filterCategory"/>

                    </children>
                </HBox>

                <TableView fx:id="tblMedia">

                    <columns>
                        <TableColumn fx:id="colMediaTitle"
                                     text="Title"/>

                        <TableColumn fx:id="colMediaCategory"
                                     text="Category"/>

                        <TableColumn fx:id="colMediaCost"
                                     text="Cost"/>
                    </columns>

                </TableView>

                <ButtonBar>
                    <buttons>

                        <Button fx:id="btnPlay"
                                text="Play"
                                visible="false"/>

                        <Button fx:id="btnRemove"
                                text="Remove"
        						visible="false"
        						onAction="#btnRemovePressed"/>
                    </buttons>
                </ButtonBar>

            </children>
        </VBox>
    </center>

    <!-- RIGHT -->
    <right>
        <VBox alignment="TOP_CENTER">
            <padding>
                <Insets top="50"/>
            </padding>

            <children>

                <HBox alignment="CENTER"
                      spacing="10">

                    <children>

                        <Label text="Total:"
                               style="-fx-font-size: 24px;"/>

                        <Label fx:id="lblTotalCost"
                               text="0 $"
                               style="-fx-font-size: 24px; -fx-text-fill: aqua;"/>

                    </children>

                </HBox>

                <Button fx:id="btnPlaceOrder"
        			text="Place Order"
        			onAction="#btnPlaceOrderPressed"/>

            </children>
        </VBox>
    </right>

</BorderPane>